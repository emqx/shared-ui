    "lint-staged": "^16.4.0",
    "prettier": "^3.0.3",
    "turbo": "^2.11.10",
    "typescript": "^5.2.2",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "4.1.12"
  }
